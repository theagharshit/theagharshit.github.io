{
  "name": "theagharshit.github.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "linkinator dist --recurse --skip \"^(?!http://localhost)\"",
    "check:all": "astro check && astro build && npm run check:html && npm run check:links"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "html-validate": "^11.21.1",
    "linkinator": "^8.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}