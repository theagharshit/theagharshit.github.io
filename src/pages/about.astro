---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import { SITE } from '../site';
// Eternal logo: save the official file as src/assets/eternal-logo.svg (or .png) and it appears automatically.
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/eternal-logo.{svg,png}', { eager: true });
const eternalLogo = Object.values(logos)[0]?.default;
---
<Base title="About" description="Harshit Agrawal builds AI systems with real users: LLM agents, RAG pipelines and automation. CSE at DTU, and Associate Program Manager at Eternal from January 2027." current="about">
  <section class="container about-hero">
    <div class="hero__text">
      <h1>Hi, I’m Harshit</h1>
      <p class="lead">I build AI-powered systems that solve real business problems, and I see them through to deployed tools with actual users.</p>
      <p class="about-body">I’m a computer science undergrad at DTU, but I’ve spent less time in classrooms and more time shipping: LLM agents, RAG pipelines, full-stack automation and agentic workflows that replace manual, repetitive work. I care about the full loop, from model to product to a result you can measure.</p>
      <div class="actions">
        <a class="btn" href={SITE.resumePdf}>Download resume</a>
        <a class="btn btn--line" href={SITE.linkedin} rel="noopener noreferrer">LinkedIn</a>
        <a class="btn btn--line" href={SITE.github} rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
    <figure class="portrait">
      <Picture src={headshot} width={900} formats={['avif', 'webp']} widths={[420, 640, 900]} sizes="(max-width: 64rem) 30rem, 30vw" alt="Harshit Agrawal" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <section class="container" aria-labelledby="next-h">
    <div class="next">
      <div class="next__logo">
        {eternalLogo
          ? <img src={eternalLogo.src} width={eternalLogo.width} height={eternalLogo.height} alt="Eternal" />
          : <span aria-hidden="true">E</span>}
      </div>
      <div>
        <h2 id="next-h">Joining Eternal</h2>
        <p>Associate Program Manager (intern)</p>
      </div>
      <p class="tag tag--status">Starting January 2027</p>
    </div>
  </section>

  <section class="section container" aria-labelledby="exp-h">
    <div class="head"><h2 id="exp-h">Experience</h2></div>
    <ol class="timeline">
      <li>
        <p class="when">May 2026 to now<br>Delhi and remote</p>
        <div>
          <h3>Founder, independent consulting</h3>
          <ul>
            <li>Building the operations system for a D2C apparel brand: catalogue, per-size stock, fulfilment and customer queries in one place the owner runs herself.</li>
            <li>Audited the live store, documented 8 operational gaps and sequenced the fixes by revenue and customer impact.</li>
            <li>Own monthly performance reporting for a portfolio of brand clients.</li>
          </ul>
        </div>
      </li>
      <li>
        <p class="when">May to Jul 2026<br>Delhi</p>
        <div>
          <h3>Applied AI Intern, Digibuggy Enterprise</h3>
          <ul>
            <li>Diagnosed a leaking lead-qualification funnel and specified the fix leadership approved and shipped.</li>
            <li>Segmented B2B prospect data in SQL and Python to re-prioritise outbound targeting.</li>
            <li>Automated daily manual sales-operations steps.</li>
          </ul>
        </div>
      </li>
      <li>
        <p class="when">May to Aug 2025<br>Kathmandu</p>
        <div>
          <h3>AI Technical Intern, Global Help Foundation</h3>
          <ul>
            <li>Rebuilt how past attendees were matched to upcoming events: repeat registrations up 47%, from 30 to 44.</li>
            <li>Ran registration and delegate operations at large conferences under live pressure.</li>
            <li>Automated manual conference workflows and reported to non-technical NGO stakeholders.</li>
          </ul>
        </div>
      </li>
    </ol>
  </section>

  <section class="container" aria-labelledby="edu-h">
    <div class="head"><h2 id="edu-h">Education</h2></div>
    <div class="duo">
      <div class="card">
        <h3>Delhi Technological University</h3>
        <p>B.Tech, Computer Science Engineering, 2023 to 2027</p>
        <p class="big-num">CGPA 7.87 / 10</p>
      </div>
      <div class="card">
        <h3>Modern Indian School</h3>
        <p>Class XII, Physics, Chemistry and Mathematics, 2023</p>
        <p class="big-num">86%</p>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="lead-h">
    <div class="head">
      <h2 id="lead-h">Leadership that shapes how I build</h2>
      <p>Systems thinking, stakeholder management and execution under pressure, learned in rooms full of people.</p>
    </div>
    <div class="duo">
      <div class="card">
        <h3>Model United Nations</h3>
        <ul>
          <li>Council Member, DelTech MUN, a conference of 400+ delegates</li>
          <li>Chairperson, organiser and delegate across 50+ MUNs in India and Nepal</li>
          <li>Invited as a guest speaker in Mumbai</li>
        </ul>
      </div>
      <div class="card">
        <h3>College, school and hackathons</h3>
        <ul>
          <li>Class Representative, DTU</li>
          <li>Built and presented an ML project at the Smart India Hackathon</li>
          <li>Vice President, Leadership Club, and co-founder, Computer Club, at school; winner of an inter-school coding competition</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container" aria-labelledby="skills-h">
    <div class="head"><h2 id="skills-h">Stack I actually use</h2></div>
    <div class="skills">
      <div><h3>AI</h3><ul class="tags"><li class="tag">LLMs (OpenAI, Claude)</li><li class="tag">LangChain</li><li class="tag">RAG</li><li class="tag">Agents</li><li class="tag">Human-in-the-loop design</li></ul></div>
      <div><h3>Building</h3><ul class="tags"><li class="tag">Python</li><li class="tag">React</li><li class="tag">Node.js</li><li class="tag">Firebase</li><li class="tag">Next.js</li><li class="tag">Postgres</li><li class="tag">REST APIs</li></ul></div>
      <div><h3>Automation and data</h3><ul class="tags"><li class="tag">n8n</li><li class="tag">GA4</li><li class="tag">SQL</li><li class="tag">Excel</li><li class="tag">Funnel and cohort analysis</li></ul></div>
      <div><h3>Working with people</h3><ul class="tags"><li class="tag">Client scoping</li><li class="tag">Stakeholder management</li><li class="tag">Public speaking</li><li class="tag">English</li><li class="tag">Hindi</li></ul></div>
    </div>
  </section>
  <div class="section"></div>
</Base>
