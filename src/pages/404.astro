---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist.">
  <section class="section section--first container section--end">
    <div class="head-block">
      <h1>This page doesn’t exist</h1>
      <p class="lead">The link may be old or mistyped.</p>
    </div>
    <div class="actions">
      <a class="btn" href="/">Go to the home page</a>
      <a class="link" href="/work/">See the work</a>
    </div>
  </section>
</Base>
