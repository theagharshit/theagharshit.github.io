---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import headshot from '../assets/headshot.jpg';
import { SITE } from '../site';

const work = (await getCollection('work')).filter((w) => w.data.home).sort((a, b) => a.data.order - b.data.order);
const [feature, ...rest] = work;
---
<Base>
  <section class="hero container">
    <div class="hero__grid">
      <div class="hero__text">
        <h1>The screen a shop runs on</h1>
        <p class="lead">I build admin panels for D2C brands, and white-label automation that agencies resell to their clients.</p>
        <div class="actions">
          <a class="btn" href={SITE.whatsapp} rel="noopener noreferrer">Message on WhatsApp</a>
          <a class="btn btn--line" href="#work">See the work</a>
        </div>
        <p class="hero__note">Harshit Agrawal. Based in Delhi, working with brands in India and Nepal.</p>
      </div>
      <figure class="portrait">
        <Picture src={headshot} width={900} formats={['avif', 'webp']} widths={[420, 640, 900]} sizes="(max-width: 64rem) 30rem, 38vw" alt="Harshit Agrawal" loading="eager" fetchpriority="high" />
        <figcaption>Taking new projects</figcaption>
      </figure>
    </div>
  </section>

  <section class="section container" id="work" aria-labelledby="work-h">
    <div class="head">
      <h2 id="work-h">Selected work</h2>
      <a class="text-link" href="/work/">All work</a>
    </div>
    <div class="work">
      {feature && (
        <article class="card card--feature">
          <ul class="tags">
            <li class="tag tag--status">{feature.data.status}</li>
            {feature.data.year && <li class="tag">{feature.data.year}</li>}
          </ul>
          <h3><a href={`/work/${feature.id}/`}>{feature.data.title}</a></h3>
          <p>{feature.data.summary}</p>
          {feature.data.link && <p class="card__domain">{new URL(feature.data.link).hostname}</p>}
          <div class="card__foot">
            {feature.data.link && <a class="text-link" href={feature.data.link} rel="noopener noreferrer">Visit the live site</a>}
          </div>
        </article>
      )}
      {rest.map((w) => (
        <article class="card card--side">
          <ul class="tags">
            <li class="tag tag--status">{w.data.status}</li>
            {w.data.year && <li class="tag">{w.data.year}</li>}
          </ul>
          <h3><a href={`/work/${w.id}/`}>{w.data.title}</a></h3>
          <p>{w.data.summary}</p>
          {w.data.result && <p class="card__result">{w.data.result}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="section container" id="build" aria-labelledby="build-h">
    <div class="head">
      <h2 id="build-h">Two things I build</h2>
      <p>Each one starts with how your team works today.</p>
    </div>
    <div class="offers">
      <div class="offer">
        <h3>For D2C brands</h3>
        <p>One screen for the whole order, instead of spreadsheets and DMs.</p>
        <ul>
          <li>Orders, stock and status on one screen</li>
          <li>One stock count every channel reads from</li>
          <li>WhatsApp confirmation before a COD parcel ships</li>
        </ul>
      </div>
      <div class="offer offer--cobalt on-cobalt">
        <h3>For agencies</h3>
        <p>Automation you sell to your clients under your own name.</p>
        <ul>
          <li>Monthly client reports written from GA4 and Ads data</li>
          <li>Lead capture and FAQ assistants for client sites</li>
          <li>Campaign reporting and instant lead routing</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="who-h">
    <div class="head">
      <h2 id="who-h">Who you’d work with</h2>
      <a class="text-link" href="/about/">More about me</a>
    </div>
    <dl class="facts">
      <div><dt>One person, start to finish</dt><dd>You talk to the person writing the code, from the first call to launch.</dd></div>
      <div><dt>Computer science at DTU</dt><dd>B.Tech at Delhi Technological University, graduating 2027.</dd></div>
      <div><dt>Results I can point to</dt><dd>Repeat registrations up 47% at Global Help Foundation, from 30 to 44.</dd></div>
    </dl>
  </section>
</Base>
