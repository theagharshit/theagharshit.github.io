---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import headshot from '../assets/headshot.jpg';
import { SITE } from '../site';

const work = (await getCollection('work')).filter((w) => w.data.home).sort((a, b) => a.data.order - b.data.order);
const [feature, sideA, sideB, wide] = work;
const side = [sideA, sideB].filter(Boolean);
---
<Base>
  <section class="hero container">
    <div class="hero__grid">
      <div class="hero__text">
        <h1>I build AI tools people actually use</h1>
        <p class="lead">LLM agents, RAG pipelines and full-stack automation that take manual, repetitive work off people’s hands. I care about the whole loop: the model, the product, and the number it moves.</p>
        <div class="actions">
          <a class="btn" href="#work">See what I’ve shipped</a>
          <a class="btn btn--line" href={SITE.whatsapp} rel="noopener noreferrer">Message on WhatsApp</a>
        </div>
        <p class="hero__note">Harshit Agrawal. Computer science at DTU, Delhi. More time shipping than in classrooms.</p>
      </div>
      <figure class="portrait">
        <Picture src={headshot} width={900} formats={['avif', 'webp']} widths={[420, 640, 900]} sizes="(max-width: 64rem) 30rem, 38vw" alt="Harshit Agrawal" loading="eager" fetchpriority="high" />
        <figcaption>Taking new projects</figcaption>
      </figure>
    </div>
  </section>

  <section class="section container" id="work" aria-labelledby="work-h">
    <div class="head">
      <h2 id="work-h">Deployed, not demos</h2>
      <a class="text-link" href="/work/">All work</a>
    </div>
    <div class="work">
      {feature && (
        <article class="card card--feature">
          <ul class="tags">
            <li class="tag tag--status">{feature.data.status}</li>
            <li class="tag">{feature.data.kind}</li>
          </ul>
          <h3><a href={`/work/${feature.id}/`}>{feature.data.title}</a></h3>
          <p>{feature.data.summary}</p>
          <p class="card__domain">Shipped to real users</p>
          {feature.data.repo && <div class="card__foot"><a class="text-link" href={feature.data.repo} rel="noopener noreferrer">View the code on GitHub</a></div>}
        </article>
      )}
      {side.map((w) => (
        <article class="card card--side">
          <ul class="tags">
            <li class="tag tag--status">{w.data.status}</li>
            <li class="tag">{w.data.kind}</li>
          </ul>
          <h3><a href={`/work/${w.id}/`}>{w.data.title}</a></h3>
          <p>{w.data.summary}</p>
          {w.data.result && <p class="card__result">{w.data.result}</p>}
          {w.data.repo && <div class="card__foot"><a class="text-link" href={w.data.repo} rel="noopener noreferrer">View code</a></div>}
        </article>
      ))}
      {wide && (
        <article class="card card--wide">
          <div>
            <ul class="tags">
              <li class="tag tag--status">{wide.data.status}</li>
              <li class="tag">{wide.data.kind}</li>
              {wide.data.year && <li class="tag">{wide.data.year}</li>}
            </ul>
            <h3><a href={`/work/${wide.id}/`}>{wide.data.title}</a></h3>
            <p>{wide.data.summary}</p>
          </div>
          {wide.data.link && <a class="text-link" href={wide.data.link} rel="noopener noreferrer">{new URL(wide.data.link).hostname}</a>}
        </article>
      )}
    </div>
  </section>

  <section class="section container" id="build" aria-labelledby="build-h">
    <div class="head">
      <h2 id="build-h">What I build</h2>
      <p>From the model to a product someone opens every day.</p>
    </div>
    <div class="offers offers--3">
      <div class="offer offer--cobalt on-cobalt">
        <h3>AI agents</h3>
        <p>LLM agents and RAG pipelines that do real work, with a person in the loop where it matters.</p>
        <ul>
          <li>Recipe generation for real users</li>
          <li>LinkedIn posts from idea to draft</li>
          <li>Assistants that answer from your own documents</li>
        </ul>
      </div>
      <div class="offer">
        <h3>Automation</h3>
        <p>Workflows that replace the manual, repetitive parts of a job.</p>
        <ul>
          <li>Marketing reports written from GA4 data</li>
          <li>n8n and API workflows between your tools</li>
          <li>Lead capture and routing</li>
        </ul>
      </div>
      <div class="offer">
        <h3>Full products</h3>
        <p>The app around the AI, built to be used by people who aren’t developers.</p>
        <ul>
          <li>Admin panels for orders and stock</li>
          <li>Catalogue sites with their own admin</li>
          <li>React, Node.js and Firebase apps</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="who-h">
    <div class="head">
      <h2 id="who-h">Who you’d work with</h2>
      <a class="text-link" href="/about/">More about me</a>
    </div>
    <dl class="facts">
      <div><dt>One person, model to launch</dt><dd>You talk to the person writing the code, from the first call to the day it ships.</dd></div>
      <div><dt>Leadership under pressure</dt><dd>Council Member at DelTech MUN, 400+ delegates. 50+ MUNs across India and Nepal.</dd></div>
      <div><dt>Results I can point to</dt><dd>Repeat registrations up 47% at Global Help Foundation, from 30 to 44.</dd></div>
    </dl>
  </section>
</Base>
