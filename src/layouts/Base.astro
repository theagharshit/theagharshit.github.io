---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';
import { SITE } from '../site';

interface Props { title?: string; description?: string; current?: 'work' | 'about' | 'resume' }
const { title, description = SITE.description, current } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}, developer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/work/', label: 'Work', key: 'work', cls: '' },
  { href: '/about/', label: 'About', key: 'about', cls: '' },
  { href: '/resume/', label: 'Resume', key: 'resume', cls: 'nav__hide' }
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Harshit Agrawal, developer">
  <meta name="twitter:card" content="summary_large_image">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav">
    <div class="container nav__inner">
      <a class="wordmark" href="/" aria-label="Harshit Agrawal, home">Harshit Agrawal</a>
      <nav aria-label="Main">
        <ul class="nav__links">
          {nav.map((item) => (
            <li class={item.cls || undefined}><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a class="nav__cta" href="#contact">Get in touch</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer" id="contact">
    <div class="container">
      <div class="contact">
        <div>
          <h2>Tell me what breaks first</h2>
          <p>Send me the screen your orders go through today, and I’ll tell you what I would build first. WhatsApp or email is fastest.</p>
        </div>
        <div class="contact__links">
          <div class="actions">
            <a class="btn" href={SITE.whatsapp} rel="noopener noreferrer">Message on WhatsApp</a>
            <a class="btn btn--line" href={`mailto:${SITE.email}`}>Email me</a>
          </div>
          <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
      </div>
      <div class="footer__grid">
        <ul class="footer__links">
          <li><a href={SITE.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={SITE.github} rel="noopener noreferrer">GitHub</a></li>
          <li><a href={SITE.whatsapp} rel="noopener noreferrer">WhatsApp {SITE.phone}</a></li>
          <li><a href={SITE.resumePdf}>Resume (PDF)</a></li>
        </ul>
        <small>Harshit Agrawal, Delhi. Built by me.</small>
      </div>
    </div>
  </footer>
</body>
</html>
